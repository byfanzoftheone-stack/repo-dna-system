# Copy to .env (gitignored). NEVER commit real values.
GITHUB_TOKEN=
# Licensing (paid tiers). Public key is safe to distribute; the private key stays offline with the owner.
DNA_LICENSE_KEY=
DNA_LICENSE_PUBKEY_FILE=
# Limits (free tier)
DNA_FREE_DAILY_SCANS=25
DNA_FREE_BATCH_LIMIT=5
# Audit log (default ./dna-extracts/audit.log.jsonl)
DNA_AUDIT_LOG=
# Human approval for spend/publish/outbound (set per command, never globally)
DNA_APPROVE=
DNA_APPROVED_BY=
# Checkout stub (dry-run unless DNA_CHECKOUT_LIVE=1). Use Stripe TEST keys first.
DNA_CHECKOUT_LIVE=0
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_TEAM=
CHECKOUT_SUCCESS_URL=
CHECKOUT_CANCEL_URL=
