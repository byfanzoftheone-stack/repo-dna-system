{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-one.local/schemas/repo_dna.schema.json",
  "title": "Organism Repository DNA",
  "description": "Canonical organism DNA. Copilot metadata/tech_stack shape is an alias only and must be translated into these keys.",
  "type": "object",
  "required": [
    "repo",
    "ref",
    "generated_at",
    "schema_version",
    "purpose",
    "core_capabilities",
    "key_assets",
    "architecture",
    "lineage_signals",
    "metrics",
    "gaps",
    "confidence",
    "evidence"
  ],
  "properties": {
    "repo": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
    "ref": { "type": "string" },
    "generated_at": { "type": "string", "format": "date-time" },
    "schema_version": { "type": "string", "const": "1.1.0" },
    "purpose": { "type": ["string", "null"] },
    "core_capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "evidence"],
        "properties": {
          "name": { "type": "string" },
          "description": { "type": ["string", "null"] },
          "evidence": { "type": "string" }
        }
      }
    },
    "key_assets": {
      "type": "object",
      "required": ["prompts", "agents", "schemas", "ui_components", "other"],
      "properties": {
        "prompts": { "type": "array" },
        "agents": { "type": "array" },
        "schemas": { "type": "array" },
        "ui_components": { "type": "array" },
        "other": { "type": "array" }
      }
    },
    "architecture": {
      "type": "object",
      "required": ["stack", "patterns", "entry_points"],
      "properties": {
        "stack": { "type": "array" },
        "patterns": { "type": "array" },
        "entry_points": { "type": "array" }
      }
    },
    "lineage_signals": { "type": "array" },
    "metrics": {
      "type": "object",
      "required": ["file_count"],
      "properties": {
        "file_count": { "type": "integer" },
        "estimated_loc": { "type": ["integer", "null"] }
      }
    },
    "gaps": { "type": "array" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "evidence": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "readme_status": {
      "type": "string",
      "enum": ["missing", "partial", "stale", "good", "unknown"]
    }
  }
}
